[Unit]
Description=RepoMind AI
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=repomind
Group=repomind
WorkingDirectory=/opt/repomind-ai/backend
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=gemma4:e2b
ExecStart=/opt/repomind-ai/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
